{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/5chm33/quantum-trader-pro/research/schemas/fundamental_fact_v1.schema.json",
  "title": "Quantum Trader Pro Point-in-Time Fundamental Fact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "identity",
    "security",
    "availability",
    "provenance",
    "accession_number",
    "form",
    "filing_accepted_at",
    "report_period_end",
    "taxonomy",
    "concept",
    "unit",
    "value",
    "amendment"
  ],
  "properties": {
    "schema_id": {"const": "qtpro.fundamental_fact.v1"},
    "identity": {"$ref": "common_v1.schema.json#/$defs/record_identity"},
    "security": {"$ref": "common_v1.schema.json#/$defs/security_identity"},
    "availability": {"$ref": "common_v1.schema.json#/$defs/availability"},
    "provenance": {"$ref": "common_v1.schema.json#/$defs/provenance"},
    "accession_number": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"},
    "form": {"type": "string", "pattern": "^(10-K|10-K/A|10-Q|10-Q/A|8-K|8-K/A|20-F|20-F/A|40-F|40-F/A|6-K|6-K/A)$"},
    "filing_accepted_at": {"$ref": "common_v1.schema.json#/$defs/utc_timestamp"},
    "report_period_start": {
      "oneOf": [{"type": "null"}, {"$ref": "common_v1.schema.json#/$defs/date"}]
    },
    "report_period_end": {"$ref": "common_v1.schema.json#/$defs/date"},
    "fiscal_year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2200},
    "fiscal_period": {"enum": ["FY", "Q1", "Q2", "Q3", "Q4", "H1", "H2", "TTM", "OTHER"]},
    "taxonomy": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$"},
    "concept": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{1,159}$"},
    "unit": {"type": "string", "minLength": 1, "maxLength": 80},
    "value": {"$ref": "common_v1.schema.json#/$defs/decimal"},
    "decimals": {"type": ["integer", "null"], "minimum": -20, "maximum": 20},
    "dimensions": {
      "type": "object",
      "additionalProperties": {"type": "string", "maxLength": 200}
    },
    "amendment": {"type": "boolean"},
    "original_accession_number": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"}
      ]
    }
  }
}

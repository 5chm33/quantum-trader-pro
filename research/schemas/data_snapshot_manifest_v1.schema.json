{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/5chm33/quantum-trader-pro/research/schemas/data_snapshot_manifest_v1.schema.json",
  "title": "Quantum Trader Pro Immutable Data Snapshot Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "snapshot_id",
    "created_at",
    "decision_cutoff_at",
    "code_commit",
    "environment_lock_sha256",
    "schema_manifest_sha256",
    "sources",
    "holdout_boundaries",
    "manifest_sha256"
  ],
  "properties": {
    "schema_id": {"const": "qtpro.data_snapshot_manifest.v1"},
    "snapshot_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "created_at": {"$ref": "common_v1.schema.json#/$defs/utc_timestamp"},
    "decision_cutoff_at": {"$ref": "common_v1.schema.json#/$defs/utc_timestamp"},
    "protocol_id": {"type": ["string", "null"], "maxLength": 128},
    "experiment_ledger_head_sha256": {
      "oneOf": [{"type": "null"}, {"$ref": "common_v1.schema.json#/$defs/sha256"}]
    },
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "environment_lock_sha256": {"$ref": "common_v1.schema.json#/$defs/sha256"},
    "schema_manifest_sha256": {"$ref": "common_v1.schema.json#/$defs/sha256"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "provider",
          "dataset",
          "provider_schema_version",
          "source_uri",
          "license_class",
          "redistribution_allowed",
          "query_sha256",
          "raw_sha256",
          "normalized_sha256",
          "record_count",
          "contract_schema_id",
          "minimum_event_at",
          "maximum_event_at",
          "maximum_available_at",
          "normalization_version"
        ],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,99}$"},
          "provider": {"type": "string", "minLength": 1, "maxLength": 100},
          "dataset": {"type": "string", "minLength": 1, "maxLength": 160},
          "provider_schema_version": {"type": "string", "minLength": 1, "maxLength": 100},
          "source_uri": {"type": "string", "format": "uri", "maxLength": 2048},
          "license_class": {"enum": ["open", "licensed_nonredistributable", "private", "synthetic"]},
          "redistribution_allowed": {"type": "boolean"},
          "query_sha256": {"$ref": "common_v1.schema.json#/$defs/sha256"},
          "raw_sha256": {"$ref": "common_v1.schema.json#/$defs/sha256"},
          "normalized_sha256": {"$ref": "common_v1.schema.json#/$defs/sha256"},
          "record_count": {"type": "integer", "minimum": 0},
          "contract_schema_id": {"type": "string", "pattern": "^qtpro\\.[a-z0-9_]+\\.v[0-9]+$"},
          "minimum_event_at": {"$ref": "common_v1.schema.json#/$defs/utc_timestamp"},
          "maximum_event_at": {"$ref": "common_v1.schema.json#/$defs/utc_timestamp"},
          "maximum_available_at": {"$ref": "common_v1.schema.json#/$defs/utc_timestamp"},
          "normalization_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,99}$"},
          "missingness_summary_sha256": {
            "oneOf": [{"type": "null"}, {"$ref": "common_v1.schema.json#/$defs/sha256"}]
          }
        }
      }
    },
    "holdout_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["holdout_id", "start_at", "end_at", "status"],
        "properties": {
          "holdout_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,99}$"},
          "start_at": {"$ref": "common_v1.schema.json#/$defs/utc_timestamp"},
          "end_at": {"$ref": "common_v1.schema.json#/$defs/utc_timestamp"},
          "status": {"enum": ["sealed", "opened_once", "retired"]},
          "receipt_sha256": {
            "oneOf": [{"type": "null"}, {"$ref": "common_v1.schema.json#/$defs/sha256"}]
          }
        }
      }
    },
    "manifest_sha256": {"$ref": "common_v1.schema.json#/$defs/sha256"}
  }
}

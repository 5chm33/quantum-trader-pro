{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/5chm33/quantum-trader-pro/research/schemas/volatility_term_structure_v1.schema.json",
  "title": "Quantum Trader Pro Point-in-Time Volatility Term Structure v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "identity",
    "availability",
    "provenance",
    "family_id",
    "methodology_version",
    "calculation_at",
    "nodes"
  ],
  "properties": {
    "schema_id": {"const": "qtpro.volatility_term_structure.v1"},
    "identity": {"$ref": "common_v1.schema.json#/$defs/record_identity"},
    "availability": {"$ref": "common_v1.schema.json#/$defs/availability"},
    "provenance": {"$ref": "common_v1.schema.json#/$defs/provenance"},
    "family_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{1,31}$"},
    "methodology_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,99}$"},
    "calculation_at": {"$ref": "common_v1.schema.json#/$defs/utc_timestamp"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_type", "instrument_id", "value", "value_type"],
        "properties": {
          "node_type": {"enum": ["spot_index", "future", "forward_variance", "realized_volatility"]},
          "instrument_id": {"type": "string", "maxLength": 80},
          "maturity_date": {"oneOf": [{"type": "null"}, {"$ref": "common_v1.schema.json#/$defs/date"}]},
          "tenor_days": {"type": ["integer", "null"], "minimum": 0, "maximum": 3650},
          "value": {"$ref": "common_v1.schema.json#/$defs/nonnegative_decimal"},
          "value_type": {"enum": ["index_points", "annualized_volatility", "annualized_variance", "price"]},
          "quote_record_id": {"type": ["string", "null"], "maxLength": 200}
        }
      }
    }
  }
}

# Quantum Trader Pro requires no credential. This file contains simulation parameters only.
QTP_DATA_FILE=/srv/quantum-trader-data/market.csv
QTP_STATE_ROOT=/var/lib/quantum-trader
QTP_SYMBOL=DEMO
QTP_INITIAL_CASH=100000
QTP_FAST_WINDOW=50
QTP_SLOW_WINDOW=200
QTP_INVESTED_FRACTION=0.95
QTP_SLIPPAGE_BPS=2
QTP_FEE_PER_ORDER=0
QTP_FEE_PER_SHARE=0.005
QTP_MAX_POSITION_FRACTION=0.95
QTP_MAX_ORDER_NOTIONAL=1000000
QTP_MIN_CASH_RESERVE_FRACTION=0.01
QTP_MAX_DRAWDOWN_FRACTION=0.20
QTP_MAX_REALIZED_LOSS=25000
QTP_MAXIMUM_GAP_DAYS=7
QTP_EXECUTABLE=/opt/quantum-trader-pro/venv/bin/quantum-trader

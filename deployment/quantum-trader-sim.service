[Unit]
Description=Quantum Trader Pro deterministic simulation
Documentation=https://github.com/5chm33/quantum-trader-pro
After=local-fs.target
ConditionPathExists=/etc/quantum-trader/simulation.env

[Service]
Type=oneshot
User=quantumtrader
Group=quantumtrader
EnvironmentFile=/etc/quantum-trader/simulation.env
WorkingDirectory=/opt/quantum-trader-pro
ExecStartPre=/opt/quantum-trader-pro/venv/bin/quantum-trader preflight
ExecStart=/opt/quantum-trader-pro/scripts/run-cloud-simulation.sh

UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RemoveIPC=yes
RestrictNamespaces=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
ReadOnlyPaths=/opt/quantum-trader-pro /srv/quantum-trader-data
ReadWritePaths=/var/lib/quantum-trader

TimeoutStartSec=2h
Restart=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=quantum-trader-sim

[Install]
WantedBy=multi-user.target
